# Copy this file to .env and fill in real values.

# ── Google OAuth (Client ID/Secret flow) ─────────────────────────────
GOOGLE_CLIENT_SECRET_PATH=credentials\client...............................
GOOGLE_TOKEN_PATH=credentials/token.json

# ── Database ──────────────────────────────────────────────────────────
DATABASE_PATH=data/***********.db

# ── Scheduling ────────────────────────────────────────────────────────
# Grace period after scheduled end before trying to close the Meet session
SESSION_END_GRACE_MINUTES=5
# How often (minutes) the scheduler checks for due actions
SCHEDULER_POLL_INTERVAL_MINUTES=2

# ── Drive recording storage ──────────────────────────────────────────
DRIVE_RECORDINGS_ROOT_FOLDER=Recordings
# Minutes to wait after class end before first checking for the recording
RECORDING_CHECK_DELAY_MINUTES=10
# How many times to retry before giving up and alerting
RECORDING_CHECK_MAX_RETRIES=60

# ── Alerting ──────────────────────────────────────────────────────────
# Email notified if a recording never appears
ALERT_EMAIL_TO=*************@gmail.com

# ── Logging ───────────────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=INFO

# ── Mode ──────────────────────────────────────────────────────────────
TEST_MODE=true
